# ──────────────────────────────────────────────
# Usine Virale 2026 — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ──────────────────────────────────────────────

# === n8n / Accès interface ===
N8N_HOST=n8n.voyages21.com
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.voyages21.com:5678/
N8N_BASIC_AUTH_USER=karim
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === PostgreSQL (interne n8n) ===
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD
POSTGRES_DB=n8n

# === Fuseau horaire ===
GENERIC_TIMEZONE=Africa/Casablanca

# ──────────────────────────────────────────────
# Credentials APIs (à entrer dans n8n, pas ici)
# Listés pour mémoire — les configurer dans n8n
# via Settings → Credentials, pas dans cet env
# ──────────────────────────────────────────────

# AIRTABLE_PAT=patXXXXXXXXXXXXXX
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# GEMINI_API_KEY=...
# CLAUDE_API_KEY=sk-ant-...

# TOPAZ_API_KEY=...
# CLAID_API_KEY=...
# OPUSCLIP_API_KEY=...

# META_GRAPH_TOKEN=...
# INSTAGRAM_BUSINESS_ID=...
# FACEBOOK_PAGE_ID=...
# LINKEDIN_ACCESS_TOKEN=...
# YOUTUBE_OAUTH_TOKEN=...
# TIKTOK_ACCESS_TOKEN=...

# OTTERLY_API_KEY=...
# SYFTEN_API_KEY=...
