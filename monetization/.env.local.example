# MongoDB Atlas - récupérer depuis https://cloud.mongodb.com (cluster gratuit M0)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/monetization?retryWrites=true&w=majority

# Mot de passe administrateur (à choisir, complexe, gardé secret)
ADMIN_KEY=change-me-with-a-very-long-secret-key-2026

# Clé Anthropic existante
ANTHROPIC_API_KEY=sk-ant-...

# URL publique du déploiement (utilisée dans les liens admin générés)
# Sur Vercel, mettre l'URL du projet, ex: https://monetization-xxx.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Modèle Claude à utiliser (optionnel, défaut: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
