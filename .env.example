# Clés API pour le comparateur multi-IA (/multi-ai)
# Renomme ce fichier en .env.local et remplis les clés disponibles.
# L'application tolère les clés manquantes : les modèles concernés afficheront une erreur.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com
OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com  (crédits gratuits à l'inscription)
DEEPSEEK_API_KEY=

# Google Gemini — https://aistudio.google.com  (free tier)
GEMINI_API_KEY=
