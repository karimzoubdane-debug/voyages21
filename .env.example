# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement Voyages21 (à définir dans Vercel → Settings → Env).
# Ne jamais committer les vraies valeurs : ce fichier ne contient que des exemples.
# ─────────────────────────────────────────────────────────────────────────────

# ── Espace admin (déjà en place) ─────────────────────────────────────────────
V21_OWNER_PASSWORD=change-me
V21_AUTH_SECRET=chaine-aleatoire-longue-et-secrete
V21_RECOVERY_CODE=code-de-secours

# ── Avis Google : connexion Google Business Profile ──────────────────────────
# Obtenus via un projet Google Cloud + OAuth (voir docs/AVIS-GOOGLE.md).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxx
GBP_ACCOUNT_ID=1234567890            # identifiant du compte Business Profile
GBP_LOCATION_ID=0987654321           # identifiant de l'établissement Voyages21

# ── Avis Google : génération IA de la réponse (optionnel mais recommandé) ─────
# Sans clé, une réponse « modèle de secours » est proposée à la place.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
REVIEW_AI_MODEL=claude-haiku-4-5-20251001
REVIEW_SIGNATURE=L'équipe Voyages21

# ── Avis Google : alerte e-mail via Resend (optionnel) ───────────────────────
# Sans clé, pas d'e-mail : les avis restent visibles dans la mini-app.
RESEND_API_KEY=re_xxxxxxxx
REVIEW_ALERT_TO=karimzoubdane@gmail.com
REVIEW_ALERT_FROM=Voyages21 <avis@voyages21.com>

# ── Avis Google : sécurité du cron + liens e-mail ────────────────────────────
# CRON_SECRET protège l'endpoint /api/avis-google/poll (Vercel l'ajoute
# automatiquement en en-tête Authorization lors des exécutions planifiées).
CRON_SECRET=chaine-aleatoire-longue
NEXT_PUBLIC_SITE_URL=https://www.voyages21.com
